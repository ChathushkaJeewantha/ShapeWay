<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/md_theme_onSecondaryFixedVariant_highContrast"/>
            <stroke android:width="2dp" android:color="@color/md_theme_tertiary"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape>
            <solid android:color="@color/colorOnCard"/>
            <stroke android:width="1dp" android:color="@color/colorSecondaryTextContainer_mediumContrast"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

</selector>