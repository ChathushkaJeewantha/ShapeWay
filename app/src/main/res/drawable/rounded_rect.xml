<?xml version="1.0" encoding="utf-8"?>

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background Color -->
    <solid android:color="#1C1C1E"/>

    <!-- Corner Radius -->
    <corners android:radius="20dp"/>

    <!-- Optional Border -->
    <stroke
        android:width="3dp"
        android:color="#333333"
        />

    <!-- Optional Padding -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp"/>

</shape>