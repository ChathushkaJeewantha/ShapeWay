<?xml version="1.0" encoding="utf-8"?>


<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">


            <!-- Question -->
            <TextView
                android:id="@+id/questionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What is your height?"
                android:textColor="@color/md_theme_onBackground_highContrast"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Unit Switch -->

            <RadioGroup
                android:id="@+id/unitSwitch"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:layout_below="@id/questionTitle"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="30dp"
                android:background="@drawable/rounded_rect"
                android:orientation="horizontal"
                android:padding="4dp"

                >

                <RadioButton
                    android:id="@+id/ftButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:button="@null"

                    android:gravity="center"
                    android:text="ft"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/cmButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:text="cm"
                    android:textColor="#FFFFFF" />
            </RadioGroup>

            <!-- Height Display -->
            <TextView
                android:id="@+id/heightValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/unitSwitch"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center"
                android:layout_marginTop="40dp"

                android:text="180"
                android:textColor="#FFFFFF"
                android:textSize="60sp"
                android:textStyle="bold" />

            <!-- Slider -->

            <TextView
                android:id="@+id/unitLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/heightValue"
                android:layout_gravity="center"
                android:layout_marginStart="100dp"

                android:layout_marginTop="-25dp"
                android:layout_toEndOf="@+id/heightValue"
                android:text="cm"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/heightSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/heightValue"
                android:layout_marginTop="40dp"
                android:value="180.00"
                android:valueFrom="100"

                android:valueTo="220"
                app:thumbColor="@color/md_theme_onBackground_highContrast" />


            <!--Weight-->

            <TextView
                android:id="@+id/questionTitle2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/heightSlider"
                android:layout_marginTop="10dp"
                android:text="What is your weight?"
                android:textColor="@color/md_theme_onBackground_highContrast"
                android:textSize="28sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/weightValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/questionTitle2"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center"
                android:inputType="number"
                android:layout_marginTop="40dp"

                android:text="70"
                android:textColor="#FFFFFF"
                android:textSize="60sp"
                android:textStyle="bold" />



            <TextView
                android:id="@+id/unitLabel2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/weightValue"
                android:layout_gravity="center"
                android:layout_marginStart="70dp"
                android:layout_marginTop="-20dp"
                android:layout_marginBottom="10dp"
                android:layout_toEndOf="@+id/weightValue"

                android:text="kg"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

<!--            Age-->

            <TextView
                android:id="@+id/questionTitle3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/unitLabel2"
                android:layout_marginTop="10dp"
                android:text="What is your age?"
                android:textColor="@color/md_theme_onBackground_highContrast"
                android:textSize="28sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/questionTitle3"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center"
                android:inputType="number"
                android:layout_marginTop="40dp"

                android:text="25"
                android:textColor="#FFFFFF"
                android:textSize="60sp"
                android:textStyle="bold" />

            <!-- Slider -->

            <TextView
                android:id="@+id/unitLabel3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/age"
                android:layout_gravity="center"
                android:layout_marginStart="80dp"
                android:layout_marginTop="-20dp"
                android:layout_marginBottom="10dp"
                android:layout_toEndOf="@+id/age"

                android:text="years"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />


            <!-- Next Button -->
            <Button
                android:id="@+id/nextButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="30dp"
                android:layout_alignParentBottom="true"
                android:backgroundTint="@color/colorAppBackgroundContainer_mediumContrast"
                android:text="NEXT STEP"
                android:textColor="@color/md_theme_onBackground_highContrast"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>