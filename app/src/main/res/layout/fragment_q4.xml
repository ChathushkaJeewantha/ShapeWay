<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="20dp"

    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- QUESTION -->

    <TextView
        android:id="@+id/txtQuestion"
        android:text="How would you describe your physical build?"
        android:textColor="@color/md_theme_onBackground_highContrast"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- GRID -->

    <GridLayout
        android:columnCount="2"
        android:rowCount="2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- CARD 1 -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/q4card1"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#111111"
            app:strokeColor="#333333">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:src="@drawable/skinny"
                    android:scaleType="centerCrop"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"/>

                <TextView
                    android:text="Slender"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <RadioButton
                    android:id="@+id/q4radio1"
                    android:layout_alignParentBottom="true"

                    android:layout_alignParentEnd="true"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"/>

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- CARD 2 -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/q4card2"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#111111"
            app:strokeColor="#333333">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:src="@drawable/medium"
                    android:scaleType="centerCrop"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"/>

                <TextView
                    android:text="Medium build"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <RadioButton
                    android:id="@+id/q4radio2"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"/>

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- CARD 3 -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/q4card3"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#111111"
            app:strokeColor="#333333">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_row="0"
                    android:layout_column="0"
                    android:scaleType="centerCrop"
                    android:src="@drawable/stockey" />

                <TextView
                    android:text="Stocky"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <RadioButton
                    android:id="@+id/q4radio3"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"/>

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- CARD 4 -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/q4card4"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#111111"
            app:strokeColor="#333333">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:src="@drawable/overweight"
                    android:scaleType="centerCrop"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"/>

                <TextView
                    android:text="Significantly overweight"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <RadioButton
                    android:id="@+id/q4radio4"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"/>

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>



    </GridLayout>

</LinearLayout>