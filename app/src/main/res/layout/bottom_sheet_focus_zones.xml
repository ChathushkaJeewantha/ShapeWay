<?xml version="1.0" encoding="utf-8"?>
<!-- bottom_sheet_focus_zones.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_button_blue">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_green_card"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Focus Zones"
        android:textSize="17sp"
        android:textColor="@color/colorAppBackground_highContrast"

        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvZoneDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Primary focus: Legs"
        android:textSize="13sp"
        android:textColor="#9E9E9E"
        android:layout_marginBottom="16dp" />

    <!-- Muscle zone image -->
    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_body_zones"
        android:layout_marginBottom="16dp" />

    <!-- Exercise list -->
    <LinearLayout
        android:id="@+id/llExerciseList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseSheet"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Close"
        android:textColor="@color/colorAppBackground_highContrast"
        app:backgroundTint="#F0F0F0"
        app:cornerRadius="14dp" />
</LinearLayout>