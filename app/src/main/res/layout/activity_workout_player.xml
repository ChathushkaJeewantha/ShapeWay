<?xml version="1.0" encoding="utf-8"?>
<!-- activity_workout_player.xml -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <!-- ── YouTube / Thumbnail area (top half) ── -->
    <FrameLayout
        android:id="@+id/flVideoContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomSheet"
        app:layout_constraintDimensionRatio="16:9">

        <!-- Thumbnail background (shown before play) -->
        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_workout_placeholder" />

        <!-- Dark overlay on thumbnail -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000" />

        <!-- YouTubePlayerView (hidden until play pressed) -->
        <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
            android:id="@+id/youtubePlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"

            app:handleNetworkEvents="true" />

        <!-- Play button overlay -->
        <FrameLayout
            android:id="@+id/flPlayOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivPlayBtn"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_circle_filled"
                android:tint="#FFFFFF"
                android:alpha="0.9" />
        </FrameLayout>

        <!-- Top bar overlay: close + sets label -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

            <ImageView
                android:id="@+id/ivClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_close"
                android:tint="#FFFFFF"
                android:padding="6dp"
                android:background="@drawable/bg_green_card" />
        </LinearLayout>
    </FrameLayout>

    <!-- ── Bottom workout info panel ── -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/flVideoContainer"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Sets / Timer row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <!-- Sets count (left) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tvSetsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SETS"
                    android:textSize="10sp"
                    android:textColor="#9E9E9E"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvSetsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="22sp"
                    android:textColor="#1A1A1A"
                    />
            </LinearLayout>

            <!-- Progress bar (center, grows) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginHorizontal="12dp">

                <ProgressBar
                    android:id="@+id/pbExercise"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_bar"
                    android:progressBackgroundTint="#EEEEEE" />
            </LinearLayout>

            <!-- Timer (right) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_green_card"
                android:padding="10dp"
                android:minWidth="72dp">

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:20"
                    android:textSize="26sp"
                    android:textColor="#1A1A1A"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Rep/Sets count right-side number -->
            <TextView
                android:id="@+id/tvRepCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textSize="22sp"
                android:textColor="#1A1A1A"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

        <!-- PREV / NEXT buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrev"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="PREV"
                android:textSize="13sp"
                android:textColor="#1A1A1A"
                app:backgroundTint="#F0F0F0"
                app:cornerRadius="12dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="NEXT"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1A1A1A"
                app:cornerRadius="12dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Next exercise preview card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#F8F8F8"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/ivNextThumb"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_workout_placeholder"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_rect" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvNextExerciseName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forward Lunges"
                        android:textColor="#1A1A1A"
                        android:textSize="13sp"
                         />

                    <TextView
                        android:id="@+id/tvNextDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:30"
                        android:textColor="#9E9E9E"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>