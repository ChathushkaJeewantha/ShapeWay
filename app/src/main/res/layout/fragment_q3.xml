<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Right Side Image -->

    <ImageView
        android:id="@+id/imgFitness"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:scaleType="centerCrop"
        android:src="@drawable/fitness_model"
        android:alpha="0.9"/>

    <!-- Content -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Question -->

        <TextView
            android:id="@+id/txtQuestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What is your experience with fitness?"
            android:textColor="@color/md_theme_onBackground_highContrast"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"/>

        <!-- Option 1 -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/q3Card1"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#111111"
            app:strokeColor="#333333"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:text="I struggle to gain weight or muscle"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <RadioButton
                    android:id="@+id/q3radio1"
                    android:layout_marginTop="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"/>

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Option 2 -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/q3card2"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#111111"
            app:strokeColor="#333333"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:text="I gain and lose weight easily"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <RadioButton
                    android:layout_marginTop="20dp"
                    android:id="@+id/q3radio2"
                    android:layout_alignParentEnd="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"/>

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Option 3 -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/q3card3"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#111111"
            app:strokeColor="#333333"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:text="I gain weight fast but lose it slowly"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <RadioButton
                    android:id="@+id/q3radio3"
                    android:layout_marginTop="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"/>

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</RelativeLayout>