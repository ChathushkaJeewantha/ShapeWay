<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TIMER + BUTTON -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:31"
                android:textColor="#4F8EF7"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/topButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"

                android:layout_weight="1"
                android:backgroundTint="@color/colorStartWorkoutContainer_mediumContrast"
                android:text="GET MY PLAN"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- BODY COMPARISON CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#111111"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:layout_weight="1"
                    android:src="@drawable/stockey" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:layout_weight="1"
                    android:src="@drawable/b2" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Your Calisthenics Workout Plan is ready!"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- PROMO CARD -->


        <!-- PLANS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <!-- PLAN ITEM -->
            <com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="16dp"
                app:strokeColor="#4F8EF7"
                app:strokeWidth="2dp">

                <TextView
                    android:id="@+id/planId"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Full Plan - LKR 3000"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"

                    />

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

        <!-- BUTTON -->
        <Button
            android:id="@+id/subBtn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="18sp"
            android:background="@drawable/bg_button_red"
            android:text="GetMyPlan"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="20dp"
            app:backgroundTint="@null" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>